<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.whisper.queue</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/path/to/your/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/node</string>
        <string>server.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/web_queue</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/whisper_queue.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/whisper_queue.err</string>
</dict>
</plist>
